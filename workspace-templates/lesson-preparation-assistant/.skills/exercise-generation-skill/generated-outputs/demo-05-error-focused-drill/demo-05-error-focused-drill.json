  "questions": [
    {
      "id": "q001",
      "knowledgePointIds": [
        "math-g5-fraction-add"
      ],
      "layer": "A",
      "questionType": "计算题",
      "difficulty": 1,
      "cognitiveLevel": "理解",
      "stem": "计算：\\frac{1}{3} + \\frac{1}{5} = ?",
      "answer": "\\frac{8}{15}",
      "solutionSteps": [
        "找到分母3和5的最小公倍数，即15。",
        "将\\frac{1}{3}通分为\\frac{5}{15}，将\\frac{1}{5}通分为\\frac{3}{15}。",
        "同分母分数相加：\\frac{5}{15} + \\frac{3}{15} = \\frac{8}{15}。"
      ],
      "commonErrors": [
        "通分错误",
        "忘记通分直接相加"
      ],
      "scorePoints": 1,
      "teachingNote": "强调通分是异分母分数加减法的关键步骤，需先统一单位再计算。",
      "sourceId": "A1",
      "estimatedTimeSec": 60,
      "isOriginal": true,
      "licenseNote": "InnoSpark-235B 动态生成·仅供教学使用"
    },
    {
      "id": "q002",
