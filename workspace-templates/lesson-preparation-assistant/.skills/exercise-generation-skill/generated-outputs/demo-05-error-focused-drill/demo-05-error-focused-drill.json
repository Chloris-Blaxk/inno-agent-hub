      ],
      "layer": "A",
      "questionType": "应用题",
      "difficulty": 2,
      "cognitiveLevel": "理解",
      "stem": "小明喝了一杯牛奶的\\frac{1}{4}，小红喝了同一杯牛奶的\\frac{2}{5}。两人一共喝了这杯牛奶的几分之几？",
      "answer": "\\frac{13}{20}",
      "solutionSteps": [
        "求一共喝了多少，用加法：\\frac{1}{4} + \\frac{2}{5}。",
        "找到分母4和5的最小公倍数，即20。",
        "将\\frac{1}{4}通分为\\frac{5}{20}，将\\frac{2}{5}通分为\\frac{8}{20}。",
        "同分母分数相加：\\frac{5}{20} + \\frac{8}{20} = \\frac{13}{20}。"
      ],
      "commonErrors": [
        "通分错误",
        "计算后未约分"
      ],
      "scorePoints": 1,
      "teachingNote": "引导学生理解‘一共’对应加法运算，并注意通分后的计算准确性。",
      "sourceId": "A2",
