      ],
      "layer": "B",
      "questionType": "计算题",
      "difficulty": 2,
      "cognitiveLevel": "应用",
      "stem": "计算：\\frac{7}{8} - \\frac{2}{5} = ?",
      "answer": "\\frac{19}{40}",
      "solutionSteps": [
        "找到8和5的最小公倍数，即40。",
        "将\\frac{7}{8}通分为\\frac{35}{40}，将\\frac{2}{5}通分为\\frac{16}{40}。",
        "进行减法运算：\\frac{35}{40} - \\frac{16}{40} = \\frac{19}{40}。"
      ],
      "commonErrors": [
