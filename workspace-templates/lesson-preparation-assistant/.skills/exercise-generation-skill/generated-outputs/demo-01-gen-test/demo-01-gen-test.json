  "questions": [
    {
      "id": "q001",
      "knowledgePointIds": [
        "math-g5-fraction-same-denominator-add"
      ],
      "layer": "A",
      "questionType": "计算题",
      "difficulty": 1,
      "cognitiveLevel": "理解",
      "stem": "计算：\\frac{4}{9} + \\frac{2}{9} = ?",
      "answer": "\\frac{2}{3}",
      "solutionSteps": [
        "分母相同，分数单位都是 \\frac{1}{9}，直接把分子相加。",
        "4 + 2 = 6，所以 \\frac{4}{9} + \\frac{2}{9} = \\frac{6}{9}。",
        "将 \\frac{6}{9} 约分，分子分母同时除以3，得到 \\frac{2}{3}。"
      ],
      "commonErrors": [
        "忘记约分",
        "分子分母相加"
      ],
      "scorePoints": 1,
      "teachingNote": "强调同分母分数加法法则：分母不变，分子相加。同时提醒学生注意结果必须化为最简分数。",
      "sourceId": "A1",
      "estimatedTimeSec": 60,
      "isOriginal": true,
      "licenseNote": "InnoSpark-235B 动态生成·仅供教学使用"
    },
    {
      "id": "q002",
      "knowledgePointIds": [
        "math-g5-fraction-same-denominator-add"
      ],
      "layer": "A",
      "questionType": "应用题",
      "difficulty": 2,
      "cognitiveLevel": "理解",
      "stem": "一瓶果汁，小明喝了 \\frac{1}{5}，小红喝了 \\frac{2}{5}，两人一共喝了这瓶果汁的几分之几？",
      "answer": "\\frac{3}{5}",
      "solutionSteps": [
        "求一共喝了多少，用加法：\\frac{1}{5} + \\frac{2}{5}。",
        "分母相同，分子相加：1 + 2 = 3，所以 \\frac{1}{5} + \\frac{2}{5} = \\frac{3}{5}。",
        "结果 \\frac{3}{5} 已经是最简分数，无需约分。"
      ],
      "commonErrors": [
        "用减法计算",
        "分母相加"
      ],
      "scorePoints": 1,
      "teachingNote": "引导学生理解“一共”表示求和，从而选择加法运算。通过具体情境帮助学生巩固同分母分数加法的实际应用。",
      "sourceId": "A2",
      "estimatedTimeSec": 60,
      "isOriginal": true,
      "licenseNote": "InnoSpark-235B 动态生成·仅供教学使用"
    },
    {
      "id": "q003",
      "knowledgePointIds": [
        "math-g5-fraction-same-denominator-add"
      ],
      "layer": "B",
      "questionType": "计算题",
      "difficulty": 2,
      "cognitiveLevel": "应用",
      "stem": "计算：\\frac{4}{9} + \\frac{2}{9} - \\frac{1}{9} = ?",
      "answer": "\\frac{5}{9}",
      "solutionSteps": [
        "按从左到右顺序计算：\\frac{4}{9} + \\frac{2}{9} = \\frac{6}{9}。",
        "\\frac{6}{9} - \\frac{1}{9} = \\frac{5}{9}。",
        "注意：\\frac{6}{9} 可以约分为 \\frac{2}{3}，但在此题中无需约分，直接计算即可。"
      ],
      "commonErrors": [
        "计算顺序错误",
        "忘记约分"
      ],
      "scorePoints": 1,
      "teachingNote": "强调同分母分数加减法的运算顺序，以及约分的必要性。",
      "sourceId": "B1",
      "estimatedTimeSec": 60,
      "isOriginal": true,
      "licenseNote": "InnoSpark-235B 动态生成·仅供教学使用"
    },
    {
      "id": "q004",
      "knowledgePointIds": [
        "math-g5-fraction-same-denominator-add"
      ],
      "layer": "B",
      "questionType": "应用题",
      "difficulty": 3,
      "cognitiveLevel": "应用",
      "stem": "一个水桶装满了水，第一次倒出 \\frac{1}{5}，第二次倒出 \\frac{2}{5}，还剩多少水？",
      "answer": "\\frac{2}{5}",
      "solutionSteps": [
        "把整桶水看作单位 1，即 \\frac{5}{5}。",
        "第一次倒出后剩下：\\frac{5}{5} - \\frac{1}{5} = \\frac{4}{5}。",
        "第二次倒出后剩下：\\frac{4}{5} - \\frac{2}{5} = \\frac{2}{5}。",
        "或者直接计算总共倒出：\\frac{1}{5} + \\frac{2}{5} = \\frac{3}{5}，然后 \\frac{5}{5} - \\frac{3}{5} = \\frac{2}{5}。"
      ],
      "commonErrors": [
        "单位 1 理解错误",
        "分步计算错误"
      ],
      "scorePoints": 1,
      "teachingNote": "引导学生理解单位 1 的概念，并掌握分步计算和整体计算两种方法。",
      "sourceId": "B2",
      "estimatedTimeSec": 60,
      "isOriginal": true,
      "licenseNote": "InnoSpark-235B 动态生成·仅供教学使用"
    },
    {
      "id": "q005",
      "knowledgePointIds": [
        "math-g5-fraction-same-denominator-add"
      ],
      "layer": "B",
      "questionType": "判断题",
      "difficulty": 2,
      "cognitiveLevel": "应用",
      "stem": "判断：\\frac{3}{7} + \\frac{2}{7} = \\frac{5}{14} 是否正确？",
      "answer": "错误",
      "solutionSteps": [
        "同分母分数相加，分母不变，分子相加。",
        "\\frac{3}{7} + \\frac{2}{7} = \\frac{3+2}{7} = \\frac{5}{7}。",
        "题目中分母相加，是错误的。"
      ],
      "commonErrors": [
        "分母相加错误",
        "混淆加减法规则"
      ],
      "scorePoints": 1,
      "teachingNote": "强调同分母分数加减法的规则，特别是分母不变的原则，避免与异分母分数运算混淆。",
      "sourceId": "B3",
      "estimatedTimeSec": 60,
